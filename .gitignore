# Jekyll build output and caches (regenerated by `jekyll build` / `jekyll serve`)
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Bundler: local gem install and per-project settings
vendor/bundle/
.bundle/

# Ruby
*.gem
.byebug_history

# Node tooling, in case any is added later
node_modules/

# Environment and secrets
.env
.env.*
!.env.example

# Logs and temp files
*.log
*.tmp
*.swp
*~

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Editors and IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
